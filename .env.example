# Entorno de ejecución: development | production | testing
ENVIRONMENT=development
APP_NAME=StudySync

# Clave secreta para firmar tokens JWT (generar una segura en producción)
SECRET_KEY=cambia-esta-clave-secreta-por-una-muy-larga-en-produccion

# Configuración de JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Base de datos:
# Local SQLite:
DATABASE_URL=sqlite:///./studysync.db
# Para PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/studysync

# Dominios permitidos en CORS separados por comas (* para permitir todos)
ALLOWED_ORIGINS=*

# Configuración SMTP para envío de correos (ej. Mailtrap para desarrollo)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@studysync.app
