# Copia este archivo como .env y completa los valores
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-segura
ENVIRONMENT=development
DATABASE_URL=sqlite:///./studysync.db

# Mailtrap para desarrollo: https://mailtrap.io -> Inboxes -> SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu_usuario_mailtrap
SMTP_PASSWORD=tu_password_mailtrap
EMAIL_FROM=noreply@studysync.app

# En produccion (Render), configura estas variables en el panel de Render
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu_cuenta@gmail.com
# SMTP_PASSWORD=tu_app_password_gmail
